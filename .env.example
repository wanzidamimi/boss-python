# BOSS 项目数据库配置模板
# 使用方法：复制本文件为 .env，并按你的实际 MySQL 配置填写下面的值。
# 注意：.env 已被 .gitignore 排除，不会提交；.env.example 仅作为模板提交。

BOSS_DB_HOST=127.0.0.1
BOSS_DB_PORT=3307
BOSS_DB_USER=boss
BOSS_DB_PASSWORD=改成你的数据库密码
BOSS_DB_NAME=boss_recruit

# 详情去重（RedisBloom）
# 容器由 docker-compose.yml 的 redis-bloom 提供（含 RedisBloom 模块）
BOSS_REDIS_URL=redis://127.0.0.1:6380/0
BOSS_BLOOM_ENABLED=1
# 去重窗口（天）：1 表示当天去重，跨天自动作废、重新采集
BOSS_BLOOM_TTL_DAYS=1
BOSS_BLOOM_ERROR_RATE=0.01
BOSS_BLOOM_CAPACITY=100000
BOSS_BLOOM_PREFIX=boss:detail:bf:

# 候选技能池 LLM 辅助判断（可选）
# 兼容 OpenAI Chat Completions 风格接口；不配置时只能人工确认候选技能
BOSS_LLM_BASE_URL=https://api.openai.com/v1
BOSS_LLM_API_KEY=改成你的APIKey
BOSS_LLM_MODEL=gpt-4o-mini
